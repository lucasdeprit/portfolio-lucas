# Content source (see src/content/source.ts). Copy to .env for local use.

# Local checkout of the content repo. Takes precedence over GitHub; handy for development.
# CONTENT_DIR=/path/to/portfolio-content

# GitHub read access to the private content repo (fine-grained token, Contents: read-only).
# GITHUB_CONTENT_TOKEN=
# CONTENT_REPO=lucasdeprit/portfolio-content
# CONTENT_REF=main

# Vercel only: seconds before a cached page is regenerated (default 300). Longer means
# fewer function runs and GitHub reads, but content edits take that long to show up.
# Read at build time, so redeploy after changing it.
# ISR_EXPIRATION=300

# Vercel only: secret (min. 32 chars) that allows on-demand ISR revalidation.
# ISR_BYPASS_TOKEN=
