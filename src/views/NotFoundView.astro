---
import BaseLayout from "../layouts/BaseLayout.astro";
import { alternates, getDictionary, localePath, type Lang, absoluteUrl } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDictionary(lang);

Astro.response.status = 404;
---

<BaseLayout
  title={`${t.notFound.title} | Lucas Deprit`}
  description={t.notFound.text}
  canonical={absoluteUrl(localePath(lang, "/"))}
  lang={lang}
  alternates={alternates("/")}
  noindex
>
  <main class="mx-auto grid min-h-screen max-w-[1600px] p-9 max-[1000px]:p-4">
    <article class="grid min-h-[calc(100vh-72px)] place-content-center border-2 border-[var(--line)] bg-[var(--paper)] p-8 shadow-[0_24px_70px_var(--shadow)] max-[1000px]:min-h-[calc(100vh-32px)]">
      <span class="[font-family:var(--font-display)] text-[clamp(120px,22vw,320px)] leading-[0.82] text-[var(--accent)]">{t.notFound.code}</span>
      <h1 class="m-0 mt-6 [font-family:var(--font-display)] text-[clamp(40px,5vw,72px)] leading-[0.9] uppercase">{t.notFound.title}</h1>
      <p class="mt-4 max-w-[560px] text-[13px] leading-[1.8] text-[var(--muted)] uppercase">{t.notFound.text}</p>
      <a
        href={localePath(lang, "/")}
        class="mt-8 w-fit border border-[var(--line)] bg-[var(--accent-soft)] px-4 py-3 text-[11px] uppercase transition-[background,transform,box-shadow] duration-180 hover:-translate-y-px hover:bg-[var(--accent)] hover:shadow-[4px_4px_0_var(--offset-shadow)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent)]"
      >
        ← {t.notFound.back}
      </a>
    </article>
  </main>
</BaseLayout>
